# ============================================================================
#  chariot/.gitignore
#  ESP32 投石小车（投掷机构 + 行驶底盘 + 工具链）
#
#  会被提交：firmware/ 源码、host/ 脚本、tools/ 脚本、docs/ 全部文档、
#            docs/assets/ 实物照片、docs/logs/ 原始串口日志
#  被忽略的：build/ 构建产物（约 100 MB，可由 arduino-cli 重新生成）
# ============================================================================

# ---------- 构建输出目录 ----------
build/
build-*/
.pio/
.pioenvs/
.piolibdeps/
platformio/
cmake-build-*/
out/
Debug/
Release/
x64/

# ---------- 编译中间件与派生镜像 ----------
# 目标文件 / 依赖 / 静态库
*.o
*.obj
*.lo
*.d
*.libsdetect.d
*.a
*.lib
*.exp
*.pdb
*.ilk
# 链接与镜像产物
*.elf
*.map
*.hex
*.su
*.lst
*.sym
*.dis
*.merged
*.merged.bin
*_flashed.bin
boot_app0.bin
*.partitions.bin
*.bootloader.bin
*.bin.tmp
# arduino-cli / ESP-IDF 构建元数据
compile_commands.json
build.options.json
includes.cache
libraries.cache
file_opts
flash_args
flash_project_args
flasher_args.json
sdkconfig
sdkconfig.old
*.cache
build_opt.h

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
env/
ENV/
.python-version
.mypy_cache/
.pytest_cache/
.ipynb_checkpoints/
*.egg-info/
dist/
.eggs/

# ---------- Obsidian ----------
# 只忽略工作区/缓存状态；插件、主题与配置本身保留
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/workspace/
.obsidian/cache
.trash/
.smart-env/
# 同步冲突副本
*conflict*
*conflicted copy*
*.sync-conflict-*

# ---------- 编辑器 / IDE ----------
.vscode/
.idea/
*.iml
*.ipr
*.iws
*.swp
*.swo
*~
\#*\#
.\#*
.history/
*.code-workspace

# ---------- 操作系统与临时文件 ----------
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
*.lnk
*.tmp
*.temp
*.bak
*.orig
*.rej
*.part
*.crdownload
*.log
~$*
nul
NUL
